{
  "name": "trurex",
  "version": "1.0.7",
  "main": "expo-router/entry",
  "homepage": "",
  "scripts": {
    "start": "node scripts/with-env.js env/native-development.env expo start --clear",
    "android": "node scripts/with-env.js env/native-development.env expo start --android --clear",
    "ios": "node scripts/with-env.js env/native-development.env expo start --ios --clear",
    "web": "node scripts/with-env.js env/web-development.env expo start --web --clear",
    "start:web:dev": "node scripts/with-env.js env/web-development.env expo start --web --clear",
    "start:web:prod": "node scripts/with-env.js env/web-production.env expo start --web --clear",
    "start:ios:dev": "node scripts/with-env.js env/native-development.env expo start --ios --clear",
    "start:android:dev": "node scripts/with-env.js env/native-development.env expo start --android --clear",
    "prebuild:native:dev": "node scripts/with-env.js env/native-development.env expo prebuild --clean",
    "run:ios:dev": "node scripts/with-env.js env/native-development.env expo run:ios",
    "run:android:dev": "node scripts/with-env.js env/native-development.env expo run:android",
    "export:web:dev": "node scripts/with-env.js env/web-development.env expo export --platform web",
    "export:web:prod": "node scripts/with-env.js env/web-production.env expo export --platform web",
    "eas:build:ios:dev": "eas build --platform ios --profile development",
    "eas:build:android:dev": "eas build --platform android --profile development",
    "eas:build:ios:prod": "eas build --platform ios --profile production",
    "eas:build:android:prod": "eas build --platform android --profile production",
    "eas:submit:ios:dev": "node scripts/with-env.js env/native-development.env eas submit --platform ios --profile development",
    "eas:submit:android:dev": "node scripts/with-env.js env/native-development.env eas submit --platform android --profile development",
    "eas:submit:ios:prod": "node scripts/with-env.js env/native-production.env eas submit --platform ios --profile production",
    "eas:submit:android:prod": "node scripts/with-env.js env/native-production.env eas submit --platform android --profile production",
    "eas:update:dev": "node scripts/with-env.js env/native-development.env eas update --channel development --environment development",
    "eas:update:preview": "node scripts/with-env.js env/native-development.env eas update --channel preview --environment development",
    "eas:update:prod": "node scripts/with-env.js env/native-production.env eas update --channel production --environment production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules pnpm-lock.yaml && pnpm install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-google-maps/api": "^2.20.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "heic2any": "^0.0.4",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "3.4.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "private": true,
  "pnpm": {
    "packageExtensions": {
      "react-native-web": {
        "dependencies": {
          "@react-native/normalize-colors": "*"
        }
      }
    },
    "patchedDependencies": {
      "react-native-maps@1.20.1": "patches/react-native-maps@1.20.1.patch"
    }
  }
}
